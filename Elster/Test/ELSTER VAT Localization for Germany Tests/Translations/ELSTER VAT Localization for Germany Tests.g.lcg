  <Item ItemId=";Codeunit 3337737470 - NamedType 302158143" ItemType=";Codeunit - GlobalVariable" PsrId="63" InstFlg="true" Leaf="true">
    <Str Cat="Text" CP="DOS">
      <Val><![CDATA[Please make sure that as well category %1 and %2 are defined in %3 %4.]]></Val>
    </Str>
    <Disp Icon="Str" Expand="true" />
    <Cmts>
      <Cmt Name="Dev"><![CDATA[%1 = Tax Pair Category; %2 = Tax Pair Category; %3 = VAT Statement Name Table Caption; %4 = VAT Statement Name Table Name]D;]A;(LookupHint=Codeunit Elster ERM Batch Reports - NamedType VATStatementNameWarningMessageErr)]]></Cmt>
    </Cmts>
  </Item>
  <Item ItemId=";Codeunit 543560743 - NamedType 3649316047" ItemType=";Codeunit - GlobalVariable" PsrId="63" InstFlg="true" Leaf="true">
    <Str Cat="Text" CP="DOS">
      <Val><![CDATA[You cannot change the value of this field anymore after the XML-File for the %1 has been created.]]></Val>
    </Str>
    <Disp Icon="Str" Expand="true" />
    <Cmts>
      <Cmt Name="Dev"><![CDATA[%1 = Sales VAT Advance Notif. Table Caption]D;]A;(LookupHint=Codeunit Elster Tables UT - NamedType CannotChangeXMLFileErr)]]></Cmt>
    </Cmts>
  </Item>
  <Item ItemId=";Codeunit 543560743 - NamedType 3414532844" ItemType=";Codeunit - GlobalVariable" PsrId="63" InstFlg="true" Leaf="true">
    <Str Cat="Text" CP="DOS">
      <Val><![CDATA[Value must be same.]]></Val>
    </Str>
    <Disp Icon="Str" Expand="true" />
    <Cmts>
