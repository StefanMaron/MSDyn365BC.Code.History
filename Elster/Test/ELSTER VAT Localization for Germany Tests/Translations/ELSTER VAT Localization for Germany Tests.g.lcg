  <Item ItemId=";Codeunit 543560743 - NamedType 1904452951" ItemType=";Codeunit - GlobalVariable" PsrId="63" InstFlg="true" Leaf="true">
    <Str Cat="Text" CP="DOS">
      <Val><![CDATA[Places of %1 in area %2 must be %3.]]></Val>
    </Str>
    <Disp Icon="Str" Expand="true" />
    <Cmts>
      <Cmt Name="Dev"><![CDATA[%1 = Registration No. Field Caption; %2 = Tax Office Area; %3 = Registration No. Length]D;]A;(LookupHint=Codeunit Elster Tables UT - NamedType WrongPlaceErr)]]></Cmt>
    </Cmts>
  </Item>
